From d8508adbcc0f522c3c94c830c03e0875c8a178a2 Mon Sep 17 00:00:00 2001
From: Orieb Ghassab <62809321+oriebalzyuot96@users.noreply.github.com>
Date: Fri, 23 Oct 2026 19:56:22 +0300
Subject: [PATCH] Re-render the pages in `PDFViewer` when the device pixel
 ratio changes

Listening for changes of the `resolution` media query was done in `PDFViewerApplication`, hence third-party users of the `PDFViewer` component (e.g. through `pdfjs-dist/web/pdf_viewer.mjs`) never re-rendered their pages when the window was moved to a monitor with a different resolution or when the browser zoom changed, which left the pages blurry.

Move the listener into `PDFViewer.setDocument`, and tie it to the existing per-document `AbortSignal` such that it's removed when the document is closed.
---
 web/app.js        | 15 ---------------
 web/pdf_viewer.js | 17 +++++++++++++++++
 2 files changed, 17 insertions(+), 15 deletions(-)

diff --git a/web/app.js b/web/app.js
index ed900ce..f7bf6d8 100644
--- a/web/app.js
+++ b/web/app.js
@@ -52,7 +52,6 @@ import {
   isDataScheme,
   isPdfFile,
   MathClamp,
-  OutputScale,
   PDFWorker,
   ResponseException,
   shadow,
@@ -2533,20 +2532,6 @@ const PDFViewerApplication = {
       signal,
     });
 
-    function addWindowResolutionChange(evt = null) {
-      if (evt) {
-        pdfViewer.refresh();
-      }
-      const mediaQueryList = window.matchMedia(
-        `(resolution: ${OutputScale.pixelRatio}dppx)`
-      );
-      mediaQueryList.addEventListener("change", addWindowResolutionChange, {
-        once: true,
-        signal,
-      });
-    }
-    addWindowResolutionChange();
-
     window.addEventListener("wheel", onWheel.bind(this), {
       passive: false,
       signal,
diff --git a/web/pdf_viewer.js b/web/pdf_viewer.js
index 3fee68d..8d001ca 100644
--- a/web/pdf_viewer.js
+++ b/web/pdf_viewer.js
@@ -35,6 +35,7 @@ import {
   AnnotationMode,
   makeArr,
   MathClamp,
+  OutputScale,
   PermissionFlag,
   PixelsPerInch,
   shadow,
@@ -992,6 +993,22 @@ class PDFViewer {
     };
     eventBus.on("pagerendered", onAfterDraw, evtOpts);
 
+    // Re-render the pages when the device pixel ratio changes, e.g. when the
+    // window is moved to a monitor with a different resolution, such that they
+    // don't become blurry.
+    const onResolutionChange = (evt = null) => {
+      if (evt) {
+        this.refresh();
+      }
+      window
+        .matchMedia(`(resolution: ${OutputScale.pixelRatio}dppx)`)
+        .addEventListener("change", onResolutionChange, {
+          once: true,
+          signal,
+        });
+    };
+    onResolutionChange();
+
     // Fetch a single page so we can get a viewport that will be the default
     // viewport for all pages
     Promise.all([firstPagePromise, permissionsPromise])
-- 
